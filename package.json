    "demo": "tsx scripts/run-demo.ts",
    "docs:diagrams": "node scripts/draw-readme-diagrams.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
